      VALUE "InternalName", "AkkoEchoUltra"
      VALUE "OriginalFilename", "AkkoEchoUltra.exe"
      VALUE "ProductName", "Akko Echo Ultra"
      VALUE "ProductVersion", "1.2.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
